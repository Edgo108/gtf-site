# Copiez ce fichier en .env.local et remplissez les valeurs
# (voir les instructions du README pour les récupérer dans Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Clé secrète (jamais exposée au navigateur, jamais NEXT_PUBLIC_) :
# Project Settings → API → service_role. Nécessaire pour la gestion des
# comptes agents (création, suspension, suppression).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
